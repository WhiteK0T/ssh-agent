# Файл: .gitignore. Локальные настройки и временные файлы разработки.

# Локальные настройки инструментов и учётных данных.
/.agents/
/.codex/
/.aws/
/.ssh/

# Настройки редакторов и хранилища Obsidian.
/.idea/
*.iml
/.vscode/
/.obsidian/

# Временные файлы и резервные копии редакторов.
*~
*.swp
*.swo
*.bak
\#*\#
.#*

# Кэш Python для проверок терминального меню.
__pycache__/
*.py[cod]

# Локальные журналы и временные каталоги.
*.log
*.tmp
/tmp/
/.tmp/
/tools/.bin/
/tools/node_modules/
.ruff_cache/

# Архивы и заметки, подготовленные для релизов.
/dist/

# Служебные файлы файловых менеджеров.
.DS_Store
Thumbs.db
